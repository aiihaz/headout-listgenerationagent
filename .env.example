OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional overrides:
# OPENAI_INTAKE_MODEL=gpt-4o-mini
# OPENAI_CONTENT_MODEL=gpt-4o-mini
# OPENAI_REVIEW_MODEL=gpt-4o-mini

# Serper API (leave blank to skip SERP research — pipeline works without it)
SERPER_API_KEY=

# Backend (leave blank to run in dev mode with filesystem fallback)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ALLOWED_ORIGINS=http://localhost:5173
